% =====================================================================
%  referencias.bib — TA-PFC-E1
%  Requisitos del enunciado:
%    - mínimo 8 referencias, todas de los últimos 5 años;
%    - al menos 4 artículos de revistas indexadas con DOI verificable;
%    - cada dato (autores, título, revista, volumen, año, páginas, DOI)
%      debe coincidir exactamente con la obra que abre el DOI.
%  Una sola referencia con datos distintos al DOI da calificación CERO.
%
%  Antes de agregar una entrada, abrir https://doi.org/<DOI> y copiar
%  los datos desde la página del editor (o su botón "Cite" en BibTeX).
%
%  Plantilla para artículo de revista (borrar el % al usarla):
%
% @article{clave2024,
%   author  = {Apellido, Nombre and Apellido, Nombre},
%   title   = {Título exacto del artículo},
%   journal = {Nombre completo de la revista},
%   year    = {2024},
%   volume  = {0},
%   number  = {0},
%   pages   = {1--10},
%   doi     = {10.xxxx/xxxxx}
% }
% =====================================================================
